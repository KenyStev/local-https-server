#!/bin/bash

# taken from: https://www.makeswift.com/blog/accessing-your-local-nextjs-dev-server-using-https

set -exo pipefail

IP=""

while (( "$#" )); do
  case "$1" in
    -i|--ip)
      IP="${2:-}"
      if [[ -z "$IP" ]]; then
        echo "Error: --ip requires an IP address" >&2
        exit 1
      fi
      shift 2
      ;;
    -h|--help)
      echo "Usage: setup-certs [-i <ip>]"
      echo "  -i|--ip: LAN IP to include in the certificate alongside localhost"
      exit 0
      ;;
    *)
      echo "Error: Unsupported argument $1" >&2
      exit 1
      ;;
  esac
done

if [[ -n "$IP" ]] && ! node -e 'const {isIP}=require("node:net"); process.exit(isIP(process.argv[1]) ? 0 : 1)' "$IP"; then
  echo "Error: Invalid IP address: $IP" >&2
  exit 1
fi

# Generate a self-signed certificate
if ! cat ./.certs/mkcert.log | grep 'The local CA is already installed in the system trust store!'; then
  echo "Generating self-signed certificate..."
  mkdir -p ./.certs
  mkcert -install 2>&1 | tee ./.certs/mkcert.log
fi

CERT_NAMES=(localhost bs-local.com)
if [[ -n "$IP" ]]; then
  CERT_NAMES+=("$IP")
fi

mkcert -cert-file ./.certs/localhost.pem -key-file ./.certs/localhost-key.pem "${CERT_NAMES[@]}"